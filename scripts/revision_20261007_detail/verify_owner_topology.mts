/** Whole material-owner topology and unchanged narrow-phase filtering diagnostics. */
import fs from'node:fs';import path from'node:path';import crypto from'node:crypto';import assert from'node:assert/strict';import{fileURLToPath}from'node:url';import * as THREE from'three';import{GLTFLoader}from'three/examples/jsm/loaders/GLTFLoader.js';import{MeshoptDecoder}from'three/examples/jsm/libs/meshopt_decoder.module.js';import{createOwnerWorldTriangles}from'./semantic_geometry.mts';
const mod='../../qa/lib/solid-contact.mjs';const{solidTopology}=await import(mod);
const ROOT=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../..'),STAGE=path.resolve(ROOT,process.env.TRANSWING_DETAIL_STAGE??'qa/revision-20261007-detail/baked-candidate');assert.ok(STAGE.startsWith(path.join(ROOT,'qa/revision-20261007-detail')+path.sep));const rows:any[]=[];
for(const file of['xp4-source.glb','xp4.glb']){const b=fs.readFileSync(path.join(STAGE,file)),g=await new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).parseAsync(b.buffer.slice(b.byteOffset,b.byteOffset+b.byteLength),'');for(const side of['L','R']){const owner=g.scene.getObjectByName('Composite_wing_'+side)!,out=createOwnerWorldTriangles(owner),topology=solidTopology(out.snapshot),rawTopology=solidTopology({triangles:out.rawTriangles});const area=(t:any)=>{const[a,b,c]=t.vertices.map((p:number[])=>new THREE.Vector3(...p as[number,number,number]));return b.sub(a).cross(c.sub(a)).length()/2;};const zeroAreaTriangles=out.rawTriangles.filter(t=>area(t)===0).map(t=>t.triangleIndex);const localAreas=out.rawLocalTriangles.map(t=>area(t));const minimumOwnerLocalTriangleArea=Math.min(...localAreas);const ownerLocalBelowOrEqual1e18=localAreas.flatMap((a,i)=>a<=1e-18?[i]:[]);rows.push({file,sha256:crypto.createHash('sha256').update(b).digest('hex'),node:owner.name,primitives:out.primitiveNames,sourceTriangleCount:out.triangleCount,rawTopology,zeroAreaTriangles,minimumOwnerLocalTriangleArea,ownerLocalBelowOrEqual1e18,unchangedCollisionSnapshotTopology:topology,skippedDegenerate:out.snapshot.skippedDegenerate,skippedTriangles:out.skippedTriangles.map(t=>({...t,worldArea:area(t),ownerLocalVertices:t.vertices.map(v=>owner.worldToLocal(new THREE.Vector3(...v as[number,number,number])).toArray())}))});}}
const passed=rows.every(r=>r.rawTopology.closed&&r.rawTopology.componentCount===1&&r.zeroAreaTriangles.length===0&&r.ownerLocalBelowOrEqual1e18.length===0&&r.skippedDegenerate===0&&r.unchangedCollisionSnapshotTopology.closed);const report={passed,rows,scope:'Aggregate every material primitive into the physical owner; report full raw topology separately from unchanged SAT degenerate filtering. A filtered open snapshot is not automatically a native hole, but it remains unresolved for this narrow-phase gate; no tolerance is relaxed.'};fs.writeFileSync(path.join(STAGE,'SEMANTIC_OWNER_TOPOLOGY_CHECK.json'),JSON.stringify(report,null,2));console.log(JSON.stringify({passed,rows:rows.map(r=>({...r,rawTopology:{closed:r.rawTopology.closed,boundaryEdges:r.rawTopology.boundaryEdgeCount},unchangedCollisionSnapshotTopology:{closed:r.unchangedCollisionSnapshotTopology.closed,boundaryEdges:r.unchangedCollisionSnapshotTopology.boundaryEdgeCount}}))},null,2));if(!passed)process.exitCode=1;
