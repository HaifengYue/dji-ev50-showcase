for(const name of['xp4-source.glb','xp4.glb']){const bytes=fs.readFileSync(path.join(STAGE,name)),doc=JSON.parse(bytes.subarray(20,20+bytes.readUInt32LE(12)).toString()),g=await new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).parseAsync(bytes.buffer.slice(bytes.byteOffset,bytes.byteOffset+bytes.byteLength),'');const rows=[];for(const n of doc.nodes.filter((n:any)=>n.mesh!==undefined)){const owner=g.scene.getObjectByName(THREE.PropertyBinding.sanitizeNodeName(n.name));assert.ok(owner);const o=createOwnerWorldTriangles(owner),raw=solidTopology({triangles:o.rawTriangles}),collision=solidTopology(o.snapshot),areas=o.rawLocalTriangles.map(area);rows.push({node:n.name,loaderType:owner.type,primitiveNames:o.primitiveNames,sourceTriangleCount:o.triangleCount,rawTopology:{closed:raw.closed,components:raw.componentCount,boundaryEdges:raw.boundaryEdgeCount,nonmanifoldEdges:raw.nonmanifoldEdgeCount},ownerLocalMinimumArea:Math.min(...areas),ownerLocalZeroAreaTriangles:areas.filter(a=>a===0).length,ownerLocalAtOrBelow1e18:areas.filter(a=>a<=1e-18).length,originalSatSkippedDegenerate:o.snapshot.skippedDegenerate,originalSatClosed:collision.closed});}assert.equal(rows.length,285);files.push({file:name,sha256:crypto.createHash('sha256').update(bytes).digest('hex'),logicalOwners:rows.length,renderedMeshPrimitives:rows.reduce((s,r)=>s+r.primitiveNames.length,0),rawClosedOwners:rows.filter(r=>r.rawTopology.closed).length,allOwnersRawClosed:rows.every(r=>r.rawTopology.closed),openOrNonmanifoldOwnerNames:rows.filter(r=>!r.rawTopology.closed).map(r=>r.node),ownersWithSatDegenerateFiltering:rows.filter(r=>r.originalSatSkippedDegenerate>0).map(r=>({node:r.node,count:r.originalSatSkippedDegenerate})),rows});}
