import{test}from'node:test';import assert from'node:assert/strict';import * as THREE from'../../../../threejs/node_modules/three/build/three.module.js';import{createOwnerWorldTriangles}from'./integrated_semantic_geometry.mts';const mod='../../qa/lib/solid-contact.mjs';const{solidTopology}=await import(mod);
function tetra(){const vertices=[[0,0,0],[1,0,0],[0,1,0],[0,0,1]],faces=[[0,2,1],[0,1,3],[0,3,2],[1,2,3]],owner=new THREE.Group();owner.name='Synthetic_material_owner';for(let m=0;m<2;m++){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(faces.slice(m*2,m*2+2).flatMap(f=>f.flatMap(i=>vertices[i])),3));const p=new THREE.Mesh(g);p.name='Material_'+m;owner.add(p);}return owner;}
test('Two open material patches form one closed physical owner without welding or tolerance changes',()=>{const owner=tetra();owner.position.set(2,-3,4);owner.rotation.set(.3,.4,-.2);owner.updateMatrixWorld(true);for(const p of owner.children)assert.equal(solidTopology(createOwnerWorldTriangles(p).snapshot).closed,false);const result=createOwnerWorldTriangles(owner);assert.equal(result.triangleCount,4);assert.equal(result.snapshot.skippedDegenerate,0);assert.equal(solidTopology(result.snapshot).closed,true);assert.equal(solidTopology(result.snapshot).componentCount,1);});
test('Removing one true material triangle remains an open solid and cannot pass by owner identity',()=>{const owner=tetra(),part=owner.children[1]as THREE.Mesh,p=part.geometry.getAttribute('position');part.geometry.setAttribute('position',new THREE.Float32BufferAttribute(Array.from(p.array).slice(0,9),3));assert.equal(solidTopology(createOwnerWorldTriangles(owner).snapshot).closed,false);});
test('An articulated group cannot be silently collapsed into a single physical owner',()=>{const scene=new THREE.Group(),pivot=new THREE.Group();pivot.add(tetra());scene.add(pivot);assert.throws(()=>createOwnerWorldTriangles(scene),/not an articulated subtree/);});
