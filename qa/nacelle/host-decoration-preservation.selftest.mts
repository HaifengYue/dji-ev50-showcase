import assert from 'node:assert/strict';
import {expectedHostDecorationSurface,mapHostDecorationPoint,HOST_DECORATION_RULE}from'./host-decoration-preservation.mts';
import {proveAccessoryTriangleBijection,type RawSurface}from'./accessory-preservation.mts';
import {subdivideOriginalSeam,proveSubdivisionOriginalSurface}from'./host-decoration-subdivision.mts';
import {saddleLiftAtWorld}from'./wing-shape-logic.mts';
const fixture=(name='Lower_fuselage_join'):RawSurface=>({name,positions:[[.29,-.114,1.13],[.30,-.114,1.13],[.29,-.114,1.14]],indices:[0,1,2],positionCount:3,indexCount:3,triangleCount:1});
const host={positions:[[.25,-.12,1.1],[.44,-.12,1.1],[.25,-.12,1.3]],indices:[[0,1,2]],sourceTriangleCount:1,skippedDegenerate:0};
export function runHostDecorationRegressions(){
 const results:any[]=[];const test=(name:string,fn:()=>void)=>{fn();results.push({name,passed:true});};
 test('nearest original triangle barycentric lift preserves the actual old vertex offset',()=>{const r=mapHostDecorationPoint('Lower_fuselage_join',[.2975,-.114,1.2],host);assert(Math.abs(r.delta-.25*.029)<1e-14);assert(Math.abs(r.originalOffset[1]-.006)<1e-14);assert(Math.abs((r.point[1]-(r.hostPoint[1]+r.delta))-.006)<1e-14);assert.notEqual(r.delta,saddleLiftAtWorld([.2975,-.114,1.2]));});
 test('full zero-displacement old host leaves every coordinate exact',()=>{const h={...host,positions:host.positions.map(p=>[p[0],p[1],p[2]+2])};const p=[.3,-.114,3.2];assert.deepEqual(mapHostDecorationPoint('Lower_fuselage_join',p,h).point,p);});
 test('fixed root cover follows the exact approved vertical translation',()=>{const p=[1,-.12,1.2];assert.deepEqual(mapHostDecorationPoint('Root_access_cover_L',p,host).point,[1,-.091,1.2]);});
 test('unknown decoration has no host-remap permission',()=>{assert.throws(()=>mapHostDecorationPoint('Dorsal_hatch_main',[1,0,1],host));});
 test('correct full cyclic mapped triangle passes unchanged source and runtime bounds',()=>{const a=fixture(),e=expectedHostDecorationSurface(a,host).surface;for(const tol of[1e-6,6e-5])assert(proveAccessoryTriangleBijection(e,structuredClone(e),tol).passed);});
 test('leaving a required cover behind is rejected',()=>{const a=fixture('Root_access_cover_R'),e=expectedHostDecorationSurface(a,host).surface;assert(!proveAccessoryTriangleBijection(e,a,1e-6).passed);});
 test('rigidly lifting the whole seam instead of its actual host mapping is rejected',()=>{const a=fixture(),e=expectedHostDecorationSurface(a,host).surface,b={...a,positions:a.positions.map(p=>[p[0],p[1]+.029,p[2]])};assert(!proveAccessoryTriangleBijection(e,b,1e-6).passed);});
 test('a circle-wide mean lift cannot replace exact per-vertex host offsets',()=>{const a=fixture(),e=expectedHostDecorationSurface(a,host).surface,d=e.positions.reduce((s,p,i)=>s+p[1]-a.positions[i][1],0)/3,b={...a,positions:a.positions.map(p=>[p[0],p[1]+d,p[2]])};assert(!proveAccessoryTriangleBijection(e,b,1e-6).passed);});
 test('evaluating the C1 law on the decoration itself is rejected',()=>{const a=fixture(),e=expectedHostDecorationSurface(a,host).surface,b={...a,positions:a.positions.map(p=>[p[0],p[1]+saddleLiftAtWorld(p),p[2]])};assert(!proveAccessoryTriangleBijection(e,b,1e-6).passed);});
 test('wrong axis and excessive endpoint movement are rejected',()=>{const a=fixture('Root_access_cover_L'),e=expectedHostDecorationSurface(a,host).surface,b={...a,positions:a.positions.map(p=>[p[0],p[1],p[2]+.029])};assert(!proveAccessoryTriangleBijection(e,b,1e-6).passed);const c=structuredClone(e);c.positions[0][0]+=.0001;assert(!proveAccessoryTriangleBijection(e,c,6e-5).passed);});
 test('reversing or dropping raw material triangles is rejected',()=>{const a=expectedHostDecorationSurface(fixture(),host).surface,b={...a,indices:[0,2,1]};assert(!proveAccessoryTriangleBijection(a,b,1e-6).passed);assert.throws(()=>proveAccessoryTriangleBijection(a,{...a,indices:[],indexCount:0,triangleCount:0},1e-6));});
 test('widened correspondence tolerance and incomplete host data are rejected',()=>{const a=fixture();assert.throws(()=>proveAccessoryTriangleBijection(a,a,.001));assert.throws(()=>expectedHostDecorationSurface(a,{...host,sourceTriangleCount:2}));assert(HOST_DECORATION_RULE.supportDistanceLimitsUnchanged);assert.deepEqual(HOST_DECORATION_RULE.encodingTolerance,{source:1e-6,runtime:6e-5});});
 const quad:RawSurface={name:'Lower_fuselage_join',positions:[[0,0,0],[.06,0,0],[.06,0,.004],[0,0,.004]].map(p=>p.map(Math.fround)),indices:[0,1,2,0,2,3],positionCount:4,indexCount:6,triangleCount:2};
 test('deterministic allowed shared-edge refinement preserves the complete original oriented material',()=>{const a=subdivideOriginalSeam(quad,[0,1]),b=subdivideOriginalSeam(quad,[0,1]);assert.deepEqual(a,b);assert(a.addedVertices>0&&a.surface.triangleCount>2);assert(proveSubdivisionOriginalSurface(quad,a.surface).passed);});
 test('all original vertices and untouched raw faces survive refinement',()=>{const q:RawSurface={...quad,positions:[...quad.positions,[2,0,0],[2.001,0,0],[2,0,.001]].map(p=>p.map(Math.fround)),indices:[...quad.indices,4,5,6],positionCount:7,indexCount:9,triangleCount:3},a=subdivideOriginalSeam(q,[0,1]);assert.deepEqual(a.surface.positions.slice(0,7),q.positions);const i=a.parents.indexOf(2);assert.deepEqual(a.surface.indices.slice(3*i,3*i+3),[4,5,6]);assert.equal(a.protectedOriginalFaces,1);});
 test('a long edge touching an unapproved original face cannot split',()=>{assert.throws(()=>subdivideOriginalSeam(quad,[0]),/protected face boundary/);});
 test('changed construction length and unknown or duplicated source-face permissions reject',()=>{assert.throws(()=>subdivideOriginalSeam(quad,[0,1],.026));assert.throws(()=>subdivideOriginalSeam(quad,[0,0]));assert.throws(()=>subdivideOriginalSeam(quad,[0,2]));});
 test('new midpoint outside original material fails complete source surface proof',()=>{const a=subdivideOriginalSeam(quad,[0,1]).surface;a.positions[4][1]+=.001;assert(!proveSubdivisionOriginalSurface(quad,a).passed);});
 test('new reversed subface fails complete oriented source coverage',()=>{const a=subdivideOriginalSeam(quad,[0,1]).surface;[a.indices[0],a.indices[1]]=[a.indices[1],a.indices[0]];assert(!proveSubdivisionOriginalSurface(quad,a).passed);});
 test('deleted source material cannot be hidden by an otherwise valid subdivision',()=>{const a=subdivideOriginalSeam(quad,[0,1]).surface;a.indices=a.indices.slice(3);a.indexCount-=3;a.triangleCount--;assert(!proveSubdivisionOriginalSurface(quad,a).passed);});
 return {passed:results.length===19,caseCount:results.length,results};
}
