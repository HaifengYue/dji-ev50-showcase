/** One-time capture from independently frozen accepted inputs; never a candidate. */
import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {captureModelReference,digest} from './model-reference.mts';
const root=process.argv[2],out=process.argv[3];assert(root&&out);assert(!fs.existsSync(out),'Never overwrite an accepted reference');
const summaryBytes=fs.readFileSync(path.join(root,'qa/current/results/summary.json')),summary=JSON.parse(summaryBytes.toString());assert(summary.passed&&summary.stages.length===44&&summary.stages.every((s:any)=>s.exitCode===0));
const models=[];for(const [encoding,file] of [['source','assets/blender/xp4-source.glb'],['runtime','public/models/xp4.glb']]){const r=await captureModelReference(path.join(root,file));assert.equal(r.modelSha256,summary[encoding+'Sha256']);models.push({encoding,...r});}
const r={formatVersion:1,purpose:'Immediate previous accepted current: exact per-node, per-mesh and animation scope. Does not replace historical collision evidence.',originCommit:'c12b288f45ecf72c5036d5e9fad42e00de4683c8',acceptedSummarySha256:digest(summaryBytes),models,manifest:JSON.parse(fs.readFileSync(path.join(root,'public/models/manifest.json'),'utf8'))};fs.writeFileSync(out,JSON.stringify(r,null,2)+'\n');console.log({passed:true,out,sha256:digest(fs.readFileSync(out)),models:models.map(m=>({encoding:m.encoding,sha256:m.modelSha256,nodes:m.nodeCount,meshes:m.meshCount}))});
